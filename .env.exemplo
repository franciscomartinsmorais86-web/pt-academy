# Só para testar no computador. Copiar para .env e preencher.
# O .env NUNCA vai para o git.
# Ler com: node --env-file=.env servidor.js   (Node 20.6+)
#
# Na Cloudflare, estas variáveis vivem no painel do projeto Pages
# (Settings > Variables and Secrets), não num ficheiro.

# Chave secreta do Resend (resend.com/api-keys). Só vive aqui, no
# servidor — se aparecer no frontend, qualquer pessoa manda email
# em nome da academia.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Para onde vão as questões do formulário.
EMAIL_DESTINO=geral@ptacademy.pt

# Remetente. O domínio tem de estar verificado no Resend; enquanto não
# estiver, usar onboarding@resend.dev (só entrega na conta do Resend).
EMAIL_REMETENTE=Site PT Academy <site@ptacademy.pt>

PORTA=3000
