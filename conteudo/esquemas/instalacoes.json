{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instalacoes.json",
  "title": "Instalações",
  "description": "Textos da página Instalações e o quadro de espaços. O passeio virtual em si (cenas e pontos) está em assets/walkthrough/walkthrough.json e é da NK.",
  "type": "object",
  "required": ["passeio", "espacos"],
  "additionalProperties": false,
  "properties": {
    "passeio": {
      "type": "object",
      "required": ["eyebrow", "titulo"],
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" }
      }
    },
    "espacos": {
      "type": "object",
      "required": ["eyebrow", "titulo", "lista"],
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" },
        "lista": {
          "type": "array",
          "minItems": 1,
          "description": "Uma linha por espaço. A numeração (01, 02…) é gerada.",
          "items": {
            "type": "object",
            "required": ["nome", "nota", "fotos"],
            "additionalProperties": false,
            "properties": {
              "nome": { "type": "string", "maxLength": 30 },
              "nota": { "type": "string", "maxLength": 40, "description": "Onde fica ou o que tem." },
              "fotos": {
                "type": "array",
                "items": { "$ref": "comum.json#/$defs/ficheiro" },
                "description": "Fotos que passam ao pôr o cursor na linha. Vazio = linha sem fotos."
              }
            }
          }
        }
      }
    }
  }
}
