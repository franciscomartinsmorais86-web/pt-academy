{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horario.json",
  "title": "Horário de aulas",
  "description": "As aulas da semana, uma por linha. O build monta a tabela das Modalidades: uma aba por item de 'abas', horas nas linhas (por ordem), dias nas colunas. Aulas no mesmo dia e hora ficam empilhadas na mesma célula, pela ordem em que aparecem aqui.",
  "type": "object",
  "required": ["dias", "abas"],
  "additionalProperties": false,
  "properties": {
    "dias": {
      "type": "array",
      "description": "As colunas da tabela, por ordem.",
      "items": {
        "type": "object",
        "required": ["id", "nome"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]{3}$" },
          "nome": { "type": "string", "description": "Cabeçalho da coluna." }
        }
      }
    },
    "abas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "Sempre duas, por esta ordem: 'cross' e 'grupo'. O modalidades.css está preso a estes ids. Muda-se o nome e as aulas, não o número de abas.",
      "items": {
        "type": "object",
        "required": ["id", "nome", "aulas"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["cross", "grupo"], "description": "Identificador interno. Não muda." },
          "nome": { "type": "string", "maxLength": 24, "description": "Texto da aba." },
          "aulas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["nome", "dia", "hora"],
              "additionalProperties": false,
              "properties": {
                "nome": { "type": "string", "maxLength": 24 },
                "dia": { "type": "string", "description": "Um dos id de 'dias'." },
                "hora": { "type": "string", "pattern": "^\\d{2}h\\d{2}$", "description": "Hora de início: '18h30'." }
              }
            }
          }
        }
      }
    }
  }
}
