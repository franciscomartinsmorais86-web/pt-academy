{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campanha.json",
  "title": "Campanha",
  "description": "A campanha em curso. Com 'ativa' a true: faixa vermelha na homepage, link vermelho no nav (à esquerda dos outros) e uma página própria em /<endereco>. Com false: nada disso existe, e quem abrir o endereço antigo vê a página 404.",
  "type": "object",
  "required": ["ativa", "nav", "endereco", "faixa", "pagina"],
  "additionalProperties": false,
  "properties": {
    "ativa": { "type": "boolean", "description": "Liga e desliga a campanha. Desliga-se à mão; não há data de fim automática." },
    "nav": { "type": "string", "maxLength": 18, "description": "Texto do link no nav. Curto." },
    "endereco": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": { "enum": ["index", "sobre", "modalidades", "instalacoes", "equipa", "contactos", "404", "assets", "conteudo", "functions", "api"] },
      "description": "Parte do link da página: /3-meses-gratis. O gestor gera-o a partir do 'nav' e bloqueia-o depois de a campanha ser criada, porque os links já partilhados deixariam de funcionar.",
      "x-bloqueado-apos-criar": true
    },
    "faixa": {
      "type": "object",
      "description": "A faixa vermelha na homepage.",
      "required": ["eyebrow", "titulo", "botao"],
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/tituloGrande" },
        "botao": { "$ref": "comum.json#/$defs/botao" }
      }
    },
    "pagina": {
      "type": "object",
      "required": ["seo", "seccoes"],
      "additionalProperties": false,
      "properties": {
        "seo": { "$ref": "comum.json#/$defs/seo" },
        "seccoes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "description": "A página, de cima para baixo. A primeira é sempre 'abertura' e a última sempre 'fecho'; o meio é livre.",
          "prefixItems": [{ "$ref": "#/$defs/abertura" }],
          "items": { "$ref": "#/$defs/seccao" },
          "x-ultima": "fecho"
        }
      }
    }
  },
  "$defs": {
    "seccao": {
      "oneOf": [
        { "$ref": "#/$defs/texto" },
        { "$ref": "#/$defs/textoFoto" },
        { "$ref": "#/$defs/lista" },
        { "$ref": "#/$defs/passos" },
        { "$ref": "#/$defs/numeros" },
        { "$ref": "#/$defs/planos" },
        { "$ref": "#/$defs/fotos" },
        { "$ref": "#/$defs/perguntas" },
        { "$ref": "#/$defs/condicoes" },
        { "$ref": "#/$defs/fecho" }
      ]
    },
    "abertura": {
      "title": "Abertura",
      "description": "Foto em ecrã inteiro com o título por cima. Sempre a primeira.",
      "type": "object",
      "required": ["tipo", "eyebrow", "titulo", "foto", "botao"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "abertura" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/tituloGrande" },
        "lead": { "$ref": "comum.json#/$defs/lead" },
        "foto": { "$ref": "comum.json#/$defs/foto" },
        "botao": { "$ref": "comum.json#/$defs/botao" }
      }
    },
    "texto": {
      "title": "Texto",
      "type": "object",
      "required": ["tipo", "eyebrow", "titulo", "paragrafos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "texto" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" },
        "paragrafos": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
        "botao": { "$ref": "comum.json#/$defs/botao" }
      }
    },
    "textoFoto": {
      "title": "Texto com foto",
      "type": "object",
      "required": ["tipo", "eyebrow", "titulo", "paragrafos", "foto", "lado"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "texto-foto" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" },
        "paragrafos": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
        "botao": { "$ref": "comum.json#/$defs/botao" },
        "foto": { "$ref": "comum.json#/$defs/foto" },
        "lado": { "enum": ["esquerda", "direita"], "description": "De que lado fica a foto." }
      }
    },
    "lista": {
      "title": "Lista",
      "type": "object",
      "required": ["tipo", "eyebrow", "titulo", "pontos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "lista" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" },
        "pontos": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "passos": {
      "title": "Passos",
      "description": "Cartões numerados (01, 02…). A numeração é gerada.",
      "type": "object",
      "required": ["tipo", "eyebrow", "titulo", "passos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "passos" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" },
        "passos": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["nome", "texto"],
            "additionalProperties": false,
            "properties": {
              "nome": { "type": "string", "maxLength": 30 },
              "texto": { "type": "string" }
            }
          }
        }
      }
    },
    "numeros": {
      "title": "Números",
      "type": "object",
      "required": ["tipo", "numeros"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "numeros" },
        "numeros": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["valor", "legenda"],
            "additionalProperties": false,
            "properties": {
              "valor": { "type": "string", "maxLength": 6, "description": "O número grande: '3', '0 €', '24h'." },
              "legenda": { "type": "string", "maxLength": 30 }
            }
          }
        }
      }
    },
    "planos": {
      "title": "Planos",
      "description": "Os cartões do planos.json, escolhidos pelo nome.",
      "type": "object",
      "required": ["tipo", "eyebrow", "titulo", "planos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "planos" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" },
        "lead": { "$ref": "comum.json#/$defs/lead" },
        "planos": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Nomes de planos que existem no planos.json." }
      }
    },
    "fotos": {
      "title": "Fotos",
      "type": "object",
      "required": ["tipo", "fotos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "fotos" },
        "fotos": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "comum.json#/$defs/foto" } }
      }
    },
    "perguntas": {
      "title": "Perguntas frequentes",
      "description": "Uma linha por pergunta, com um + que vira − ao abrir. As respostas começam fechadas.",
      "type": "object",
      "required": ["tipo", "titulo", "perguntas"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "perguntas" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/titulo" },
        "perguntas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["pergunta", "resposta"],
            "additionalProperties": false,
            "properties": {
              "pergunta": { "type": "string" },
              "resposta": { "type": "string" }
            }
          }
        }
      }
    },
    "condicoes": {
      "title": "Condições",
      "description": "Letra pequena a cinzento, sempre à vista, numa faixa antes do fecho.",
      "type": "object",
      "required": ["tipo", "titulo", "paragrafos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "condicoes" },
        "titulo": { "type": "string" },
        "paragrafos": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "fecho": {
      "title": "Fecho",
      "description": "Faixa bordô. Sempre a última.",
      "type": "object",
      "required": ["tipo", "eyebrow", "titulo", "botoes"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "fecho" },
        "eyebrow": { "$ref": "comum.json#/$defs/eyebrow" },
        "titulo": { "$ref": "comum.json#/$defs/tituloGrande" },
        "botoes": { "$ref": "comum.json#/$defs/botoes" }
      }
    }
  }
}
